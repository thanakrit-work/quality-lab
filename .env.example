# Copy this file to ".env" and fill in your own token.
#   cp .env.example .env
#
# Get a free token by signing in at https://gorest.co.in/  ->  "Access Token".
# The .env file is git-ignored, so your token is never committed.

GOREST_API_TOKEN=paste_your_gorest_token_here

# Optional overrides (defaults shown). Uncomment only if you need to change them.
# GOREST_BASE_URI=https://gorest.co.in
# GOREST_BASE_PATH=/public/v2
