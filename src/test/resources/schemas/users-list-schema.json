{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "UserList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "email", "gender", "status"],
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "gender": {
        "type": "string",
        "enum": ["male", "female"]
      },
      "status": {
        "type": "string",
        "enum": ["active", "inactive"]
      }
    }
  }
}
